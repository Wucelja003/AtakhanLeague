// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  googleId  String?  @unique
  username  String   @unique
  role      Role     @default(PLAYER)

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Tournament registrations — a user can captain one team OR sign up individually.
  team                   Team?
  individualRegistration IndividualRegistration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  PLAYER
  ADMIN
}

model Team {
  id              String       @id @default(uuid())
  name            String       @unique
  division        String
  captainId       String       @unique
  captainUsername String       // snapshot of captain's summoner name at registration
  captainRole     LaneRole?    // captain's lane in the team
  captain         User         @relation(fields: [captainId], references: [id], onDelete: Cascade)
  members         TeamMember[] // the other 4 players the captain adds later
  createdAt       DateTime     @default(now())
}

// Other 4 players in a team (captain adds them later from Profile page).
// captainRole on Team + 4 members = 5 lanes total. Unique constraint prevents
// two players taking the same lane in the same team.
model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  teamName  String   // snapshot of team name for easy admin lookup
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  username  String   // summoner name of this player
  role      LaneRole
  division  String?
  createdAt DateTime @default(now())

  @@unique([teamId, role])
}

model IndividualRegistration {
  id        String   @id @default(uuid())
  userId    String   @unique
  username  String   // snapshot of summoner name at registration
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  division  String
  role      LaneRole
  createdAt DateTime @default(now())
}

enum LaneRole {
  TOP
  JUNGLE
  MID
  ADC
  SUPPORT
}
