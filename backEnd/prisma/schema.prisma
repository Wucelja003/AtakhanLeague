// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  googleId  String?  @unique
  username  String   @unique
  role      Role     @default(PLAYER)

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Riot account verification (linked at signup via Riot API)
  riotPuuid    String?  @unique  // globally unique Riot account ID
  riotGameName String?           // game name part of Riot ID
  riotTagLine  String?           // tag part — free text ("1529"), NOT a region
  riotPlatform String?           // eun1/euw1/... — asked of Riot, cached here

  // Tournament registrations — a user can captain one team OR sign up individually.
  team                   Team?
  individualRegistration IndividualRegistration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  PLAYER
  ADMIN
}

model Team {
  id              String       @id @default(uuid())
  name            String       @unique
  division        String
  captainId       String       @unique
  captainUsername String       // snapshot of captain's summoner name at registration
  captainRole     LaneRole?    // captain's lane in the team
  captain         User         @relation(fields: [captainId], references: [id], onDelete: Cascade)
  members         TeamMember[] // the other 4 players the captain adds later
  paid            Boolean      @default(false) // entry fee paid (set by payment webhook)
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
}

// Other 4 players in a team (captain adds them later from Profile page).
// captainRole on Team + 4 members = 5 lanes total. Unique constraint prevents
// two players taking the same lane in the same team.
model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  teamName  String   // snapshot of team name for easy admin lookup
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  username  String   // summoner name of this player
  role      LaneRole
  division  String?
  createdAt DateTime @default(now())

  @@unique([teamId, role])
}

model IndividualRegistration {
  id        String   @id @default(uuid())
  userId    String   @unique
  username  String   // snapshot of summoner name at registration
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  division  String
  role      LaneRole
  paid      Boolean  @default(false) // entry fee paid (set by payment webhook)
  paidAt    DateTime?
  createdAt DateTime @default(now())
}

// One row per payment attempt. Reconciled by provider webhooks via orderId.
model Payment {
  id         String   @id @default(uuid())
  orderId    String   @unique          // our reference passed to the provider
  provider   String                    // 'paypal' | 'nowpayments'
  externalId String?                   // provider's order/invoice id
  status     String   @default("pending") // pending | paid | failed | expired
  amount     Int                       // cents: 3000 (team) or 600 (individual)
  currency   String   @default("EUR")
  kind       String                    // 'team' | 'individual'
  userId     String                    // the paying user (captain or solo)
  username   String?                   // snapshot of the payer's summoner name
  email      String?                   // snapshot of the payer's email
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

enum LaneRole {
  TOP
  JUNGLE
  MID
  ADC
  SUPPORT
}

// Single-elimination bracket: 7 fixed matches (QF1-4, SF1-2, F).
// Admin seeds team names into the QFs and enters scores; winners propagate.
model Match {
  id         String   @id @default(uuid())
  code       String   @unique  // QF1..QF4, SF1, SF2, F
  round      String            // quarterfinal | semifinal | final
  order      Int               // display order within a round
  time       String            // e.g. "18:00"
  teamAName  String?
  teamBName  String?
  scoreA     Int?
  scoreB     Int?
  winnerName String?
  updatedAt  DateTime @updatedAt
}

// Leaderboard entry — points the organizer awards for tournament performance.
// Keyed by summoner name so players without an account can be ranked too.
model Ranking {
  id        String   @id @default(uuid())
  username  String   @unique
  team      String?           // team they currently play for
  tier      String?           // IRON..CHALLENGER — drives the rank emblem
  division  String?           // I..IV (empty for Master+)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([points])
}
